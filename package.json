{
  "name": "chat-v-streamer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:check": "tsx scripts/demo-check.ts",
    "format": "prettier --write server web/src scripts tests *.ts *.md",
    "format:check": "prettier --check server web/src scripts tests *.ts *.md",
    "browser:check": "tsx scripts/browser-check.ts",
    "rehearsal:check": "tsx scripts/rehearsal-check.ts",
    "connected:readiness": "tsx scripts/connected-readiness.ts",
    "connected:check": "tsx scripts/connected-check.ts",
    "connected:observe": "tsx scripts/connected-observe.ts"
  },
  "dependencies": {
    "@twurple/api": "^7.3.0",
    "@twurple/auth": "^7.3.0",
    "@twurple/eventsub-ws": "^7.3.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "obs-websocket-js": "^5.0.6",
    "openai": "^6.0.0",
    "pino": "^9.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.12"
  }
}
